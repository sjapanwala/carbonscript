func;int prompt $void {
 stdout 1 - Addition
 stdout 2 - Subtraction
 stdout 3 - Multiplication
 stdout 4 - Division
 stdin choice;int Choice?
 fi ( ?choice < 4 || ?choice > 0 ) return ?choice
}



 let operation;int
 set operation = @prompt
 stdout
 stdin num1;int First Number? 
 stdin num2;int Second Number? 
 fi ( ?operation == 1 ) stdout ( ?num1 + ?num2 )
 fi ( ?operation == 2 ) stdout ( ?num1 - ?num2 )
 fi ( ?operation == 3 ) stdout ( ?num1 * ?num2 )
 fi ( ?operation == 4 ) stdout ( ?num1 / ?num2 )
 default stdout Unknown Operation Listed


