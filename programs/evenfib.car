RULE hide-errors

// generating a fibonacci sequence
// adds all the even numbers to a sum
// part of q2 for eulars problems

func;int generateFibonacci $n;int {
    set a = 1;int
    set b = 2;int
    let sequence;arr

    push sequence ?a
    push sequence ?b
    set n = ceil($n)
    set fibIt = ( ?n - 2 )
    repeat ?fibIt {
        set next = ( ?a + ?b )
        push sequence ?next
        set a = ?b
        set b = ?next
    }
    
    let evenarr;arr
    repeat ?n {
        pop sequence
        if ( ?pop % 2 == 0 ) push evenarr ?pop
    }
    
    set sum = 0;int

    length ?evenarr
    repeat ?len {
        pop evenarr
        set sum = ( ?pop + ?sum )
    }
    stdout "Sum of Even Fibonacci Numbers - Iterations: $n "
    return ?sum
}

set ans = @generateFibonacci 50
stdout ?ans
