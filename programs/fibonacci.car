// generating a fibonacci sequence

func;void generateFibonacci $n;int {
    set a = 0;int
    set b = 1;int
    let sequence;arr

    push sequence ?a
    push sequence ?b
    set fibIt = ( $n - 2 )

    repeat ?fibIt {
        set next = ( ?a + ?b )
        push sequence ?next
        set a = ?b
        set b = ?next
    }

    stdout "Fibonacci Sequence:" ?sequence
}

@generateFibonacci 12
