// generating a fibonacci sequence

func;void generateFibonacci $n;int {
    set a = 0;int
    set b = 1;int
    let sequence;arr

    push sequence ?a
    push sequence ?b
    set fibIt = ( $n - 2 )

    repeat ?fibIt {
        set next = ( ?a + ?b )
        push sequence ?next
        set a = ?b
        set b = ?next
    }

    stdout "Fibonacci Sequence:" ?sequence
    // un comment this if you want them listed one by one
    // length ?sequence
    // repeat ?len {
    //    pop sequence
    //     stdout ?pop
    // }
    
}
if ( ?args[1] != cnum("void") ) set runIterations = ?args[1]
else set runIterations = 10;int
stdout "Fibonacci Sequence - Iterations:" ?runIterations
@generateFibonacci ?runIterations
