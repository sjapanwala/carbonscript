// how does fiz buzz workd?
// i / 3 and 5 == fizzbuzz
// i / 3 == fizz
// i / 5 == buzz

func;void fizzBuzz $n;int {
  let resultArray;arr
  set interLen = ceil($n)
  set repetition = 0;int
  repeat ?interLen {
    set repetition = ( ?repetition + 1 )
    if ( ?repetition % 15 == 0 ) push resultArray "fizzbuzz"
    ifelse ( ?repetition % 3 == 0 ) push resultArray "fizz"
    ifelse ( ?repetition % 5 == 0 ) push resultArray "buzz"
    else push resultArray ?repetition
  }
  stdout ?resultArray
}
if ( ?args[1] != cnum("void") ) set runIterations = ?args[1]
else set runIterations = 10;int
stdout "FizzBuzz - Iterations:" ?runIterations
@fizzBuzz ?runIterations
