// Play A game where you have to guess a random number
// written by github.com/sjapanwala
// 02/03/25

RULE hide-errors

// This is a simple guessing game, writtin in CarbonScript!

func;int prompt {
  stdout "Welcome To Guessing Game!"
  stdout "---"
  stdout "1) Easy   1-10"
  stdout "2) Medium 1-100"
  stdout "3) Hard   1-1000"
  stdout "---"
  stdin option;int "Please Choose An Option"
  set choice = 0;int
  fi ( ?option < 0 || ?option > 3 ) set choice = 0;int
  default set choice = ?option
  return ?choice
}

func;void setRandoms $choice;int {
  set randmin = 1;int
  fi ( $choice == 1 ) set randmax = 10;int
  elsefi ( $choice == 2 ) set randmax = 100;int
  elsefi ( $choice == 3 ) set randmax = 1000;int
}

func;int startGame {
  rand ?randmin ?randmax
  set ai = ?rand
  stdout --- Guess Between ?randmin and ?randmax --- 
  stdin usr;int "Please Make Your Guess"
  fi ( ?usr > ?ai ) stdout "Your Guess Was Larger Than The Actual Guess!"
  elsefi ( ?usr < ?ai ) stdout "Your Guess Was Smaller Than The Actual Guess!"
  default stdout "Your Guess Was Correct!"
  return ?ai
}


// where the main code goes

set prchoice = @prompt
@setRandoms ?prchoice
set aiGuess = @startGame
stdout "The Actual Guess Was:" ?aiGuess




